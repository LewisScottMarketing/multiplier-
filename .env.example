# ── Server ────────────────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
# Where the SQLite database, uploaded PDFs and generated files live. Mount a volume here.
DATA_DIR=./.data

# Public URL of this app (dashboard + API). Used for cookies, links and webhooks.
APP_URL=http://localhost:3000
# Base URL used in the personalised links you send to prospects. Defaults to APP_URL.
# Use a dedicated domain here (e.g. https://go.yourbrand.com) to protect your main domain's reputation.
PUBLIC_URL=

# Signs sessions and encrypts stored secrets. If unset, a random key is generated and
# saved to DATA_DIR/secret.key on first boot.
APP_SECRET=

# Set to true when running behind a reverse proxy / load balancer (reads X-Forwarded-For).
TRUST_PROXY=false

# ── First-run bootstrap (optional, handy for Docker) ──────────────────────
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Uploads ───────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=25

# ── AI (optional) ─────────────────────────────────────────────────────────
# Enables AI-assisted PDF → page import, per-prospect AI copy fields and persona variant suggestions.
# Everything works without it (deterministic fallbacks).
ANTHROPIC_API_KEY=
AI_MODEL_SMART=claude-sonnet-5-5
AI_MODEL_FAST=claude-haiku-5-5
