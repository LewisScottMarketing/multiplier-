# ── Server ────────────────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0
# Where the SQLite database, uploaded PDFs and generated files live. Mount a volume here.
DATA_DIR=./.data

# Public URL of this app (dashboard + API). Used for cookies, links and webhooks.
APP_URL=http://localhost:3000
# Base URL used in the personalised links you send to prospects. Defaults to APP_URL.
# Use a dedicated domain here (e.g. https://go.yourbrand.com) to protect your main domain's reputation.
PUBLIC_URL=

# Signs sessions and encrypts stored secrets. If unset, a random key is generated and
# saved to DATA_DIR/secret.key on first boot.
APP_SECRET=

# Set to true when running behind a reverse proxy / load balancer (reads X-Forwarded-For).
TRUST_PROXY=false

# ── Docker Compose + Caddy (docker compose --profile proxy up -d) ─────────
# Hostname of the dashboard (the host part of APP_URL, e.g. app.yourbrand.com) and an email for
# Let's Encrypt notices. Also set TRUST_PROXY=true above.
APP_HOST=
ACME_EMAIL=

# ── First-run bootstrap (optional, handy for Docker) ──────────────────────
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Uploads ───────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=25

# ── AI (optional) ─────────────────────────────────────────────────────────
# Turns on three things: a personal line of copy per prospect (AI fields), "write a version for
# marketing / sales / executives…" on any block, and light polishing of weak copy when you import a PDF.
# Everything works without it: pages use the fallback text you set.
# For AI fields, each prospect's name, company, job title and custom fields are sent to Anthropic's API.
# Email addresses and LinkedIn URLs are never sent.
ANTHROPIC_API_KEY=
# Runs once per campaign: persona versions and PDF polish.
AI_MODEL_SMART=claude-opus-5-5
# Runs once per prospect, so it should be fast and cheap. Use the same model as above if you prefer.
AI_MODEL_FAST=claude-haiku-5-5
# Longest a single AI call may take before the fallback text is used (milliseconds, 2000-90000).
AI_TIMEOUT_MS=20000
