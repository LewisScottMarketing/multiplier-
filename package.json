{
  "name": "multiplier",
  "version": "0.1.0",
  "private": true,
  "description": "Turn one PDF into a personalised landing page and PDF for every prospect. Plugs into Clay.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --disable-warning=ExperimentalWarning --import tsx --watch src/server/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build --config web/vite.config.ts",
    "build:server": "esbuild src/server/index.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/server/index.js",
    "start": "node --disable-warning=ExperimentalWarning dist/server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json",
    "seed": "node --disable-warning=ExperimentalWarning --import tsx scripts/seed.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"web/src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\"",
    "dev:fake-ai": "node --disable-warning=ExperimentalWarning --import tsx scripts/dev-fake-ai.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@hono/node-server": "^2.1.5",
    "@napi-rs/canvas": "^1.0.13",
    "@pdf-lib/fontkit": "^1.1.1",
    "@tanstack/react-query": "^5.104.5",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.9.0",
    "hono": "^4.13.13",
    "lucide": "^1.61.0",
    "lucide-react": "^1.61.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "sanitize-html": "^2.18.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "playwright-core": "1.56.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
